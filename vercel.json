{
   "version": 2,
   "builds": [
      {
         "src": "index.html",
         "use": "@vercel/static"
      },
      {
         "src": "fonts/**/*",
         "use": "@vercel/static"
      }
   ],
   "routes": [
      {
         "handle": "filesystem"
      },
      {
         "src": "/",
         "dest": "/index.html"
      }
   ]
}
